@model ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="page-header">
    <h1>My Profile</h1>
    <p class="mb-0">@Model.Email</p>
</div>

<h3 class="fw-bold mb-3">My Orders</h3>

@if (!Model.Orders.Any())
{
    <div class="card empty-state">
        <span class="empty-glyph">🧾</span>
        <h5>You have no orders yet</h5>
        <p><a asp-controller="Home" asp-action="Index">Browse products</a> and start shopping!</p>
    </div>
}
else
{
    foreach (var order in Model.Orders)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <strong>Order #@order.Id</strong>
                    <span class="text-muted ms-3">@order.CreatedAt.ToLocalTime().ToString("g")</span>
                </div>
                <span class="badge order-status @(order.Status == "Pending" ? "bg-warning" : "bg-success")">@order.Status</span>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm mb-2">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Qty</th>
                                <th class="text-end">Price</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in order.Items)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td>@item.Quantity</td>
                                    <td class="text-end">@item.Price.ToString("C")</td>
                                    <td class="text-end">@item.LineTotal.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="order-total">
                    <span class="text-muted">Order total</span>
                    <span class="fw-bold fs-5">@order.Total.ToString("C")</span>
                </div>
            </div>
        </div>
    }
}
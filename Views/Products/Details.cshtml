@model ProductDetails

@{
    ViewData["Title"] = "Details";
    bool isFav = ViewBag.IsFavorite == true;
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="d-flex align-items-center mb-4">
    <h2 class="mb-0">@Model.Name</h2>
</div>

@if (!string.IsNullOrEmpty((string?)ViewBag.Notice))
{
    <div class="alert alert-warning mb-4">@ViewBag.Notice</div>
}

<div class="row">
    <div class="col-md-6 mb-4">
        <div class="card h-100 position-relative">
            <form asp-controller="Favorites" asp-action="Toggle" asp-route-id="@Model.Id" method="post"
                  class="js-favorite-form position-absolute top-0 end-0 m-2" style="z-index: 5;">
                <input type="hidden" name="returnUrl" value="@currentUrl" />
                <button type="submit"
                        class="btn btn-sm rounded-circle shadow-sm btn-heart @(isFav ? "btn-danger" : "")"
                        title="@(isFav ? "Remove from favorites" : "Add to favorites")">
                    @(isFav ? "❤️" : "🤍")
                </button>
            </form>

            <model-viewer id="productModel"
                          class="model-frame"
                          src="/Assets/models/@(Model.Id).glb"
                          poster="@Model.ImageUrl"
                          alt="@Model.Name"
                          camera-controls
                          auto-rotate
                          disable-zoom
                          onerror="this.style.display='none'; document.getElementById('modelFallback').classList.remove('d-none');">
            </model-viewer>
            <img id="modelFallback"
                 src="@Model.ImageUrl"
                 class="card-img-top d-none"
                 style="height: 300px; object-fit: cover;"
                 onerror="this.onerror=null;this.src='/Placeholder.jpg'"
                 alt="@Model.Name" />

            <div class="card-body">
                <h5 class="card-title">@Model.Name</h5>
                <p class="price-tag fw-bold fs-4 mb-0">@Model.Price.ToString("C")</p>
            </div>

            <div class="card-footer d-flex flex-wrap gap-2">
                @if (Model.IsAvailable)
                {
                    <form asp-controller="Cart" asp-action="AddToCart" asp-route-id="@Model.Id" method="post" class="flex-fill">
                        <input type="hidden" name="returnUrl" value="@Url.Action("Details", "Products", new { id = Model.Id })" />
                        <div class="mb-2">
                            <label class="form-label fw-semibold mb-1">Size</label>
                            @if (Model.Sizes.Any())
                            {
                                <select name="wearSizeId" class="form-select" required>
                                    <option value="">-- Select size --</option>
                                    @foreach (var size in Model.Sizes)
                                    {
                                        <option value="@size.Id">@size.Name</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <div class="form-control-plaintext">Default</div>
                                <input type="hidden" name="wearSizeId" value="0" />
                            }
                        </div>
                        <div class="mb-2">
                            <label class="form-label fw-semibold mb-1">Color</label>
                            @if (Model.Colors.Any())
                            {
                                <select name="wearColorId" class="form-select" required>
                                    <option value="">-- Select color --</option>
                                    @foreach (var color in Model.Colors)
                                    {
                                        <option value="@color.Id">@color.Name</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <div class="form-control-plaintext">Default</div>
                                <input type="hidden" name="wearColorId" value="0" />
                            }
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Add to cart</button>
                    </form>
                }
                else
                {
                    <button type="button" class="btn btn-secondary w-100" disabled>Out of stock</button>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">About this product</h5>
                <p class="card-text">@Model.Description</p>
                <hr />
                <p class="mb-1"><span class="badge bg-secondary">@Model.CategoryName</span></p>
                @if (Model.Sizes.Any())
                {
                    <p class="mb-1">Sizes: <span class="fw-bold">@string.Join(", ", Model.Sizes.Select(s => s.Name))</span></p>
                }
                @if (Model.Colors.Any())
                {
                    <p class="mb-1">Colors: <span class="fw-bold">@string.Join(", ", Model.Colors.Select(c => c.Name))</span></p>
                }
                <p class="mb-1">In stock: <span class="fw-bold">@Model.StockQuantity</span></p>
                @if (Model.IsAvailable)
                {
                    <span class="badge bg-success">In stock</span>
                }
                else
                {
                    <span class="badge bg-danger">Out of stock</span>
                }
            </div>
        </div>
    </div>
</div>

<a asp-controller="Categories" asp-action="Details" asp-route-id="@Model.CategoryId" class="btn btn-outline-secondary mt-4">Go back to Category</a>

@section Scripts {
    <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js"></script>
}

@model CategoryDetails

@{
    ViewData["Title"] = "Details";
}

<div class="d-flex align-items-center gap-4 mb-4">
    <img src="@Model.ImageUrl"
         class="rounded-circle shadow-sm"
         style="width: 72px; height: 72px; object-fit: cover;"
         onerror="this.onerror=null;this.src='/Placeholder.jpg'"
         alt="@Model.Name" />
    <div>
        <h2 class="mb-0 fw-bold">@Model.Name</h2>
        <span class="badge bg-secondary mt-1">@Model.Field</span>
    </div>
</div>

<p class="text-muted mb-4">@Model.Description</p>

<h4 class="fw-bold mb-3">Products</h4>

@if (Model.Products.Count == 0)
{
    <div class="card empty-state">
        <span class="empty-glyph">📦</span>
        <h5>No products yet</h5>
        <p>New items are coming soon.</p>
    </div>
}
else
{
    <div class="row">
        @foreach (var product in Model.Products)
        {
            <div class="col-md-4 mb-4">
                <partial name="_ProductCard" model="product" />
            </div>
        }
    </div>
}

<a asp-controller="Categories" asp-action="Index" class="btn btn-outline-secondary mt-4">Go back to Categories</a>
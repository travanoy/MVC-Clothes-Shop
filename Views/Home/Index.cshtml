@model List<ProductListItem>
@{
    ViewData["Title"] = "Home Page";
}

<img src="~/home-banner.jpg" alt="Home banner" class="hero-banner mb-0" />

<form method="get" asp-controller="Home" asp-action="Index" class="search-box mb-4">
    <div class="input-group">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control"
               placeholder="Search by name, category or description..." style="margin-top: 2rem;" />
        <button type="submit" class="btn btn-primary" style="margin-top: 2rem;">Search</button>
    </div>
</form>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Featured Products</h3>
    <span class="text-muted muted-count">@Model.Count items</span>
</div>

@if (!Model.Any())
{
    <div class="card empty-state">
        <span class="empty-glyph">🔍</span>
        <h5>No products found</h5>
        <p>Try a different search or <a asp-controller="Categories" asp-action="Index">browse all categories</a>.</p>
    </div>
}
else
{
    <div class="row">
        @foreach (var product in Model)
        {
            <div class="col-md-4 col-lg-3 mb-4">
                <partial name="_ProductCard" model="product" />
            </div>
        }
    </div>
}
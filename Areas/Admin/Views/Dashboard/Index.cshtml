@model List<ProductListItem>
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="page-header">
    <h1>Admin Panel</h1>
    <p class="mb-0">Store overview</p>
</div>

<div class="row mb-4 g-3">
    <div class="col-md-6 col-xl-4">
        <div class="stat-card">
            <div class="stat-label">Categories</div>
            <div class="stat-value">@ViewBag.CategoriesCount</div>
            <div class="stat-foot">
                <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="btn-manage">Manage</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-4">
        <div class="stat-card">
            <div class="stat-label">Products</div>
            <div class="stat-value">@ViewBag.ProductsCount</div>
            <div class="stat-foot">
                <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="btn-manage">Manage</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-4">
        <div class="stat-card">
            <div class="stat-label">Available now</div>
            <div class="stat-value">@ViewBag.AvailableProducts</div>
        </div>
    </div>
    <div class="col-md-6 col-xl-4">
        <div class="stat-card">
            <div class="stat-label">Users</div>
            <div class="stat-value">@ViewBag.UsersCount</div>
            <div class="stat-foot">
                <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn-manage">Manage</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-4">
        <div class="stat-card">
            <div class="stat-label">Pending orders</div>
            <div class="stat-value">@ViewBag.PendingOrders</div>
            <div class="stat-foot">
                <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="btn-manage">Manage</a>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">All Products</h5>
        <a asp-area="Admin" asp-controller="Products" asp-action="Create" class="btn btn-sm btn-primary btn-add">+ Add product</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td class="fw-semibold">@product.Name</td>
                        <td>@product.CategoryName</td>
                        <td>@product.Price.ToString("C")</td>
                        <td>
                            @if (product.IsAvailable)
                            {
                                <span class="badge bg-success">In stock</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Out of stock</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
@model List<CategoryListItem>
@{
    ViewData["Title"] = "Categories - Admin";
}

<div class="page-head">
    <h1>Categories</h1>
    <a asp-action="Create" class="btn btn-primary btn-add">+ Add category</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 70px;"></th>
                    <th>Name</th>
                    <th>Field</th>
                    <th>Description</th>
                    <th>Products</th>
                    <th style="width: 170px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model)
                {
                    <tr>
                        <td>
                            <img src="@category.ImageUrl" alt="@category.Name"
                                 class="rounded-circle" style="width: 48px; height: 48px; object-fit: cover;"
                                 onerror="this.onerror=null;this.src='/Placeholder.jpg'" />
                        </td>
                        <td class="fw-semibold">@category.Name</td>
                        <td><span class="badge bg-secondary">@category.Field</span></td>
                        <td>@category.Description</td>
                        <td>@category.ProductsCount</td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-primary btn-action">Edit</a>
                                <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-outline-danger btn-action">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
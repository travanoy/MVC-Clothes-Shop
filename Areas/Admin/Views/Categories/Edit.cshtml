@model CategoryForm
@{
    ViewData["Title"] = "Edit Category - Admin";
}

<div class="page-head">
    <h1>Edit category</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ImageUrl" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Field" class="form-label"></label>
                        <input asp-for="Field" class="form-control" placeholder="e.g. Tops, Bottoms" />
                        <span asp-validation-for="Field" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Current image</label>
                        <div>
                            <img src="@Model.ImageUrl" style="max-height: 150px; border-radius: .65rem; object-fit: cover;"
                                 onerror="this.onerror=null;this.src='/Placeholder.jpg'" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Image" class="form-label"></label>
                        <input asp-for="Image" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                        <span asp-validation-for="Image" class="text-danger"></span>
                        <div class="form-text">Leave empty to keep the current image.</div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">Save</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
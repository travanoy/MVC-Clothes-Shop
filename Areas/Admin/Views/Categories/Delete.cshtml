@model CategoryListItem
@{
    ViewData["Title"] = "Delete Category - Admin";
}

<div class="page-head">
    <h1>Delete category</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
</div>

<div class="alert alert-danger">
    Are you sure you want to delete "@Model.Name"? All its products (@Model.ProductsCount) will also be deleted!
</div>

<div class="card my-4" style="max-width: 480px;">
    <img src="@Model.ImageUrl" class="card-img-top" style="height: 200px; object-fit: cover;"
         onerror="this.onerror=null;this.src='/Placeholder.jpg'" alt="@Model.Name" />
    <div class="card-body">
        <h5 class="card-title">@Model.Name</h5>
        <span class="badge bg-secondary mb-2">@Model.Field</span>
        <p class="card-text">@Model.Description</p>
    </div>
</div>

<form asp-action="Delete" method="post" class="d-flex gap-2">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger px-4">Delete</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
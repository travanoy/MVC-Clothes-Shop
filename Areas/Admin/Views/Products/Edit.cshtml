@model ProductForm
@{
    ViewData["Title"] = "Edit Product - Admin";
}

<div class="page-head">
    <h1>Edit product</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ImageUrl" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label"></label>
                        <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                            <option value="">-- Select category --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Stock quantity per size and color</label>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered align-middle text-center">
                                <thead>
                                    <tr>
                                        <th>Size \ Color</th>
                                        @foreach (var color in Model.Colors)
                                        {
                                            <th>@color.Text</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var sizeRow in Model.StockGrouped)
                                    {
                                        <tr>
                                            <th class="text-nowrap">@sizeRow.Name</th>
                                            @foreach (var cell in sizeRow.Cells)
                                            {
                                                <td>
                                                    <input type="hidden" name="Stock[@cell.Index].SizeId" value="@cell.SizeId" />
                                                    <input type="hidden" name="Stock[@cell.Index].ColorId" value="@cell.ColorId" />
                                                    <input type="number" name="Stock[@cell.Index].Quantity" value="@cell.Quantity" min="0" class="form-control form-control-sm text-center" />
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="form-text">Enter 0 to not offer that size and color combination.</div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Price" class="form-label"></label>
                            <input asp-for="Price" class="form-control" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="StockQuantity" class="form-label"></label>
                            <input asp-for="StockQuantity" class="form-control" />
                            <span asp-validation-for="StockQuantity" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Current image</label>
                        <div>
                            <img src="@Model.ImageUrl" style="max-height: 150px; border-radius: .65rem; object-fit: cover;"
                                 onerror="this.onerror=null;this.src='/Placeholder.jpg'" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Image" class="form-label"></label>
                        <input asp-for="Image" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                        <span asp-validation-for="Image" class="text-danger"></span>
                        <div class="form-text">Leave empty to keep the current image.</div>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input asp-for="IsAvailable" class="form-check-input" role="switch" />
                        <label asp-for="IsAvailable" class="form-check-label"></label>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">Save</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
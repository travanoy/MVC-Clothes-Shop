@model List<ProductListItem>
@{
    ViewData["Title"] = "Products - Admin";
}

<div class="page-head">
    <h1>Products</h1>
    <a asp-action="Create" class="btn btn-primary btn-add">+ Add product</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 70px;"></th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Sizes</th>
                    <th>Colors</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th style="width: 170px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td>
                            <img src="@product.ImageUrl" alt="@product.Name"
                                 class="rounded-circle" style="width: 48px; height: 48px; object-fit: cover;"
                                 onerror="this.onerror=null;this.src='/Placeholder.jpg'" />
                        </td>
                        <td class="fw-semibold">@product.Name</td>
                        <td>@product.CategoryName</td>
                        <td>@(product.SizeNames.Any() ? string.Join(", ", product.SizeNames) : "-")</td>
                        <td>@(product.ColorNames.Any() ? string.Join(", ", product.ColorNames) : "-")</td>
                        <td>@product.Price.ToString("C")</td>
                        <td>@product.StockQuantity</td>
                        <td>
                            @if (product.IsAvailable)
                            {
                                <span class="badge bg-success">In stock</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Out of stock</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary btn-action">Edit</a>
                                <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger btn-action">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
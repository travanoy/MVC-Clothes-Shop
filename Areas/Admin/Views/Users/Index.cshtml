@model List<UserListItem>
@{
    ViewData["Title"] = "Users";
}

<div class="page-header">
    <h1>Users</h1>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr class="@(user.IsLockedOut ? "table-danger" : "")">
                        <td class="fw-semibold">
                            @user.Email
                        </td>
                        <td>
                            @if (user.IsAdmin)
                            {
                                <span class="badge bg-warning">Admin</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Customer</span>
                            }
                        </td>
                        <td>
                            @if (user.IsLockedOut)
                            {
                                <span class="badge bg-danger">Blocked</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (ViewBag.CurrentUserId != user.Id)
                            {
                                <form asp-action="ToggleAdmin" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@user.Id" />
                                    @Html.AntiForgeryToken()
                                    @if (user.IsAdmin)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-warning btn-action"
                                                onclick="return confirm('Remove admin role?')">
                                            Demote
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success btn-action">
                                            Promote
                                        </button>
                                    }
                                </form>

                                <form asp-action="ToggleLock" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@user.Id" />
                                    @Html.AntiForgeryToken()
                                    @if (user.IsLockedOut)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-primary btn-action"
                                                onclick="return confirm('Unblock this user?')">
                                            Unblock
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-danger btn-action"
                                                onclick="return confirm('Block this user?')">
                                            Block
                                        </button>
                                    }
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small">You</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
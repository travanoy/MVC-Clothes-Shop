@model List<AdminOrderListItem>
@{
    ViewData["Title"] = "Orders - Admin";
}

<div class="page-head">
    <h1>Orders</h1>
    <span class="muted-count">@Model.Count total orders</span>
</div>

@if (!Model.Any())
{
    <div class="card empty-state">
        <span class="empty-glyph">🧾</span>
        <h5>No orders yet</h5>
        <p>Orders will appear here once customers check out.</p>
    </div>
}
else
{
    foreach (var order in Model)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <strong>Order #@order.Id</strong>
                    <span class="text-muted ms-2">@order.UserEmail</span>
                    <span class="text-muted ms-2">@order.CreatedAt.ToLocalTime().ToString("g")</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge order-status @(order.Status == "Pending" ? "bg-warning" : "bg-success")">@order.Status</span>
                    @if (order.Status == "Pending")
                    {
                        <form asp-action="Complete" asp-route-id="@order.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-success btn-action">Complete</button>
                        </form>
                    }
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm mb-2">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Qty</th>
                                <th class="text-end">Price</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in order.Items)
                            {
                                <tr>
                                    <td>
                                        @item.Name
                                        @if (!string.IsNullOrEmpty(item.SizeName))
                                        {
                                            <span class="text-muted d-block">Size: @item.SizeName</span>
                                        }
                                        @if (!string.IsNullOrEmpty(item.ColorName))
                                        {
                                            <span class="text-muted d-block">Color: @item.ColorName</span>
                                        }
                                    </td>
                                    <td>@item.Quantity</td>
                                    <td class="text-end">@item.Price.ToString("C")</td>
                                    <td class="text-end">@item.LineTotal.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="order-total">
                    <span class="text-muted">Order total</span>
                    <span class="fw-bold fs-5">@order.Total.ToString("C")</span>
                </div>
            </div>
        </div>
    }
}